{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "typeRoots": ["../../tools/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["src", "../../crates/contracts/data/*.ts"]
}
