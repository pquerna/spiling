{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local Spiling workbench engine supervision and runtime diagnostics only",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:window:allow-close",
    "allow-engine-start",
    "allow-engine-status",
    "allow-engine-stop",
    "allow-engine-restart",
    "allow-engine-triangle",
    "allow-engine-interrupt",
    "allow-runtime-info",
    "allow-engine-run-diagnostic",
    "allow-engine-get-operation",
    "allow-engine-cancel-operation",
    "allow-engine-read-artifact"
  ]
}
