{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local diagnostic and token-scoped native authoring workbench",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:window:allow-close",
    "allow-engine-start",
    "allow-engine-status",
    "allow-engine-stop",
    "allow-engine-restart",
    "allow-engine-triangle",
    "allow-engine-interrupt",
    "allow-runtime-info",
    "allow-engine-run-diagnostic",
    "allow-engine-get-operation",
    "allow-engine-cancel-operation",
    "allow-engine-read-artifact",
    "allow-engine-native-operation",
    "allow-geometry-select-sources",
    "allow-geometry-import-source",
    "allow-geometry-control",
    "allow-geometry-chunk",
    "allow-geometry-debug-select-sources",
    "allow-project-select-path",
    "allow-project-debug-select-path",
    "allow-project-control",
    "allow-project-open",
    "allow-project-save",
    "allow-project-reopen"
  ]
}
